# Copy to .env.local and fill in. Never commit real values.

# --- PayPal (sandbox REST app) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Leave as "sandbox". This prototype is not meant for live credentials.
PAYPAL_ENV=sandbox
# Webhook ID from the PayPal dashboard, for https://YOUR-APP/api/paypal/webhook
PAYPAL_WEBHOOK_ID=

# --- AI model: set ONE of these keys ---
# Groq (free tier): https://console.groq.com/keys
GROQ_API_KEY=
# Claude: https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional: force a provider when both keys are set (groq or anthropic)
# LLM_PROVIDER=groq
# Optional model overrides (defaults: Groq openai/gpt-oss-120b / openai/gpt-oss-20b,
# Claude claude-opus-5-5 / claude-haiku-5-5)
# SELLER_MODEL=
# AUX_MODEL=
# Set to "off" to skip the small-model check in the outbound filter
# POLICY_LLM_CHECK=on

# --- App ---
# Public URL of the app, used for PayPal return links (e.g. https://counter.onrender.com)
APP_BASE_URL=http://localhost:3000
# Secret used to sign quotes. Generate a long random string for a deployment.
QUOTE_SIGNING_SECRET=
# Optional: require this token for the seller console, Red Team and reset endpoints
ADMIN_TOKEN=
